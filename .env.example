# PRESS'D environment variables — placeholders only. Never commit real values.
# Set these in Vercel → Project → Settings → Environment Variables.
# All of them are server-side only (none use the NEXT_PUBLIC_ prefix).

# ---------------------------------------------------------------- public site (existing)
# Google rating and reviews on the About section (Places API, server-side).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ---------------------------------------------------------------- SEO Studio tag editor (/admin/seo)
# Production origin used for canonical/share URLs and URL validation.
SEO_SITE_URL=https://www.pressdcafe.ae

# Postgres (Neon). Use a SEPARATE database for Preview. Then run: npm run db:migrate
DATABASE_URL=

# Who may sign in: email:role:password-hash, comma-separated.
# Roles: viewer | editor (drafts only) | publisher (publish/restore) | admin (+ settings)
# Create each hash with:  npm run seo:hash-password
# e.g. SEO_ADMIN_USERS=owner@example.com:admin:scrypt.32768.8.1.xxxx.yyyy, seo@agency.example:publisher:scrypt.32768.8.1.xxxx.yyyy
SEO_ADMIN_USERS=

# Encrypts session cookies. At least 32 characters: openssl rand -base64 48
SEO_SESSION_SECRET=
